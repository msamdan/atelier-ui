{
  "name": "atelier-ui",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "ng": "ng",
    "dev": "vite",
    "start": "pnpm run dev",
    "build": "vite build",
    "watch": "vite build --watch",
    "test": "vitest",
    "preview": "node dist/analog/server/index.mjs",
    "build:theme": "node scripts/build-theme.mjs",
    "predev": "pnpm prepare:icons && pnpm build:theme",
    "prebuild": "pnpm prepare:icons && pnpm build:theme",
    "pretest": "pnpm build:theme",
    "test:ci": "pnpm build:theme && vitest run && node --test packages/theme/src/*.test.mjs",
    "pack:theme": "pnpm --filter atelier-theme pack --pack-destination artifacts",
    "format": "prettier --write src packages scripts docs .github README.md CONTRIBUTING.md CHANGELOG.md THIRD_PARTY_NOTICES.md package.json vite.config.ts index.html",
    "format:check": "prettier --check src packages scripts docs .github README.md CONTRIBUTING.md CHANGELOG.md THIRD_PARTY_NOTICES.md package.json vite.config.ts index.html",
    "test:package": "node scripts/test-package.mjs",
    "prepare:icons": "node scripts/prepare-icons.mjs"
  },
  "private": true,
  "dependencies": {
    "@analogjs/content": "^2.7.5",
    "@analogjs/router": "^2.7.5",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/platform-server": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@ng-web-apis/universal": "^5.3.0",
    "@taiga-ui/cdk": "^5.25.0",
    "@taiga-ui/core": "^5.25.0",
    "@taiga-ui/event-plugins": "^5.1.0",
    "@taiga-ui/icons": "^5.25.0",
    "@taiga-ui/kit": "^5.25.0",
    "@taiga-ui/styles": "^5.25.0",
    "front-matter": "^4.0.2",
    "h3": "^1.13.0",
    "marked": "^15.0.7",
    "marked-gfm-heading-id": "^4.1.1",
    "marked-highlight": "^2.2.1",
    "marked-mangle": "^1.1.10",
    "prismjs": "^1.29.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "atelier-theme": "workspace:*"
  },
  "devDependencies": {
    "@analogjs/platform": "^2.7.5",
    "@analogjs/vite-plugin-angular": "^2.7.5",
    "@analogjs/vitest-angular": "^2.7.5",
    "@angular/build": "^22.0.0",
    "@angular/cli": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "@playwright/test": "^1.63.0",
    "jsdom": "^22.0.0",
    "less": "^4.9.1",
    "prettier": "^3.9.9",
    "typescript": "~6.0.0",
    "vite": "^8.0.0",
    "vite-tsconfig-paths": "^4.2.0",
    "vitest": "^4.1.0"
  },
  "overrides": {
    "vite": "$vite",
    "vitest": "$vitest"
  },
  "description": "An open-source Angular, Analog, and Taiga UI dashboard starter with a reusable theme.",
  "license": "MIT",
  "packageManager": "pnpm@11.25.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/msamdan/atelier-ui.git"
  },
  "homepage": "https://github.com/msamdan/atelier-ui#readme",
  "bugs": {
    "url": "https://github.com/msamdan/atelier-ui/issues"
  }
}
